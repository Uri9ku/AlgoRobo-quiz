<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devPanel"
    android:layout_width="344dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dev_panel"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- 顶部拖动条：上下拖动调整窗口高度 -->
    <LinearLayout
        android:id="@+id/devResizeTop"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_dev_grip" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/devHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="控件信息（拖动此栏移动｜拉动上/下边调高度）"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/devClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <TextView
        android:id="@+id/devLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="@color/primary" />

    <!-- 两列信息区：纵向滚动，行内容过长可横向滑动，每行右侧有单独复制按钮 -->
    <ScrollView
        android:id="@+id/devInfoScroll"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_tag_gray"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/devInfoRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="父控件"
            android:textSize="11sp"
            android:textColor="@color/text_sub" />

        <SeekBar
            android:id="@+id/devLevelBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="子控件"
            android:textSize="11sp"
            android:textColor="@color/text_sub" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/devCopy"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="复制信息"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary_press" />

        <TextView
            android:id="@+id/devCopyLocator"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="复制定位符"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary_press" />

        <TextView
            android:id="@+id/devClear"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="清除选择"
            android:textSize="12sp"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_btn_outline_press" />
    </LinearLayout>

    <!-- 底部拖动条：上下拖动调整窗口高度 -->
    <LinearLayout
        android:id="@+id/devResizeBottom"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_dev_grip" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/card_bg">
    <!-- 顶部标题栏（粉笔风格蓝色区） -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_header_chalk" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="答题卡" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white"/>
        <TextView android:id="@+id/tvSheetProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="已答 0/15 题" android:textSize="13sp" android:textColor="@color/text_on_primary_70"/>
    </LinearLayout>

    <!-- 主体区 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <GridView android:id="@+id/gridSheet" android:layout_width="match_parent" android:layout_height="wrap_content" android:numColumns="5" android:verticalSpacing="10dp" android:horizontalSpacing="10dp" android:stretchMode="columnWidth"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnSheetClose" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="关闭" android:textSize="15sp" android:textColor="@color/primary" android:background="@drawable/bg_btn_outline"/>
            <TextView android:id="@+id/btnSheetSubmit" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="交卷" android:textSize="15sp" android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
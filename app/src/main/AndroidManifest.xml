<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 真题原文件需写入用户可访问的下载目录（默认系统 Download 目录，可在设置更改）：
         Android 11+ 用「所有文件访问权限」，10 及以下用读写存储权限。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 打开下载目录需要解析系统「文件」应用；Android 11+ 需显式声明查询意图，否则解析被包可见性限制拦截 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
    </queries>
    <application
        android:name=".App"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlgoRobo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AllAnalysisActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WrongBookActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ExamListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ImportOnlineActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CheckInActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StatisticsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AiConfigActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CustomBankActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".KnowledgeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="@android:color/transparent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp" android:background="@color/primary">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="编程刷题工具箱" android:textSize="22sp"
                android:textStyle="bold" android:textColor="@android:color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="刷题 · 解析 · 错题 · 统计" android:textSize="13sp"
                android:textColor="#CCFFFFFF" />

            <!-- 今日进度概览 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal"
                android:background="#33FFFFFF" android:padding="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvTodayCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="20sp"
                        android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="今日答题" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvTotalCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="20sp"
                        android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="累计答题" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvAccuracy" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0%" android:textSize="20sp"
                        android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="正确率" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvStreak" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textSize="20sp"
                        android:textStyle="bold" android:textColor="@android:color/white" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="连续打卡" android:textSize="11sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardPractice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
            android:layout_marginTop="12dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📄" android:textSize="22sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="真题练习" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_main" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="编程题库在线练" android:textSize="12sp" android:textColor="@color/text_sub" />
            </LinearLayout>
            <TextView android:id="@+id/btnResume" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="继续上次▶" android:textSize="12sp" android:textColor="@color/primary"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp"
                android:background="@drawable/bg_resume" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/modeSequence" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical" android:gravity="center"
                android:padding="14dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="题库练习" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>
            <LinearLayout android:id="@+id/modeRandom" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical" android:gravity="center"
                android:padding="14dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎲" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="随机练习" android:textSize="13sp" android:textColor="@color/text_main" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardWrongBook" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📕" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="错题本" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="回顾做错的题目" android:textSize="12sp" android:textColor="@color/text_sub" />
            </LinearLayout>
            <TextView android:id="@+id/badgeWrong" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="11sp" android:textColor="@android:color/white"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_danger" android:minWidth="20dp" android:gravity="center"
                android:visibility="gone" android:layout_marginEnd="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardFavorite" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收藏题" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="回顾收藏的题目" android:textSize="12sp" android:textColor="@color/text_sub" />
            </LinearLayout>
            <TextView android:id="@+id/badgeFavorite" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textSize="11sp" android:textColor="@android:color/white"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_warning" android:minWidth="20dp" android:gravity="center"
                android:visibility="gone" android:layout_marginEnd="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardStatistics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="学习统计" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardCalendar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗓️" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="打卡日历" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardCustomBank" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧩" android:textSize="20sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="自定义题库" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>

        <LinearLayout android:id="@+id/cardKnowledge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="8dp" android:layout_marginBottom="80dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="@drawable/bg_card">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧭" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="知识点专题" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_main" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="按考点分类刷题" android:textSize="12sp" android:textColor="@color/text_sub" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="22sp" android:textColor="@color/text_sub" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/fabSettings" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="bottom|end" android:layout_marginEnd="20dp" android:layout_marginBottom="20dp"
        android:padding="16dp" android:background="@drawable/bg_btn_primary" android:src="@drawable/ic_settings"
        android:contentDescription="设置" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 分享用的题目卡片（浅色、固定宽度 540dp，由代码测量绘制成图片） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 顶部品牌条 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="14dp" android:paddingBottom="14dp">
        <TextView android:id="@+id/cardBrand" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="AlgoRobo 刷题" android:textSize="16sp"
            android:textStyle="bold" android:textColor="@android:color/white" />
        <TextView android:id="@+id/cardType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="单选题" android:textSize="13sp" android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/cardIndex" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="第 1 题" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primary" />
            <TextView android:id="@+id/cardKnowledge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end"
                android:text="知识点" android:textSize="11sp" android:textColor="#666666"
                android:background="@drawable/bg_tag_light" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="2dp" android:paddingBottom="2dp" android:visibility="gone" />
        </LinearLayout>

        <TextView android:id="@+id/cardStem" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="" android:textSize="18sp" android:lineSpacingExtra="5dp"
            android:textColor="#1C1C1E" />

        <ImageView android:id="@+id/cardStemImage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:visibility="gone" android:contentDescription="题干图片" />

        <LinearLayout android:id="@+id/cardOptionImages" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"
            android:visibility="gone" />

        <TextView android:id="@+id/cardOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="" android:textSize="15sp" android:lineSpacingExtra="6dp"
            android:textColor="#1C1C1E" />

        <View android:id="@+id/cardDivider" android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:background="#E5E5E5" />

        <TextView android:id="@+id/cardAnswer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#30A14E" />

        <TextView android:id="@+id/cardAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="" android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:textColor="#444444" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/cardFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingBottom="14dp" android:text="— 由 AlgoRobo 刷题生成 —"
        android:textSize="11sp" android:textColor="#999999" />
</LinearLayout>

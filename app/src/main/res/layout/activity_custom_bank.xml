<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_page">

    <!-- 顶部栏 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/primary" android:padding="12dp">
        <TextView android:id="@+id/btnCustomBankBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="‹ 返回"
            android:textSize="16sp" android:textColor="@android:color/white" android:padding="4dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="自定义题库"
            android:textSize="17sp" android:textStyle="bold" android:textColor="@android:color/white"/>
        <TextView android:layout_width="40dp" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- 统计信息 -->
            <TextView android:id="@+id/tvCustomBankCount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="当前题库共 0 题"
                android:textSize="13sp" android:textColor="@color/text_sub"/>

            <!-- 两种添加方式 -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="添加题目" android:textSize="13sp"
                android:textColor="@color/text_sub" android:layout_marginBottom="8dp"/>

            <!-- 方式一：手动输入 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✍️ 手动输入题目" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/text_main"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="题目（题干）" android:textSize="13sp"
                    android:textColor="@color/text_sub"/>
                <EditText android:id="@+id/etStem" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="2" android:hint="请输入题目内容"
                    android:textColor="@color/text_main" android:textColorHint="@color/text_sub"
                    android:background="@drawable/bg_option_normal" android:padding="12dp"
                    android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="选项（每行一个，从 A 开始）"
                    android:textSize="13sp" android:textColor="@color/text_sub"/>
                <LinearLayout android:id="@+id/optionsInputContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginTop="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="正确答案（输入 A/B/C/D...）"
                    android:textSize="13sp" android:textColor="@color/text_sub"/>
                <EditText android:id="@+id/etAnswer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="例如：A"
                    android:textColor="@color/text_main" android:textColorHint="@color/text_sub"
                    android:background="@drawable/bg_option_normal" android:padding="12dp"
                    android:layout_marginTop="4dp" android:inputType="text" android:maxLength="1"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="解析（可选）" android:textSize="13sp"
                    android:textColor="@color/text_sub"/>
                <EditText android:id="@+id/etAnalysis" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minLines="2" android:hint="请输入解析内容（可选）"
                    android:textColor="@color/text_main" android:textColorHint="@color/text_sub"
                    android:background="@drawable/bg_option_normal" android:padding="12dp"
                    android:layout_marginTop="4dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="16dp">
                    <TextView android:id="@+id/btnSaveOne" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:gravity="center" android:text="保存并继续添加" android:textSize="14sp"
                        android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary"
                        android:padding="12dp"/>
                    <TextView android:id="@+id/btnSaveDone" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:gravity="center" android:text="保存并完成"
                        android:textSize="14sp" android:textColor="@android:color/white"
                        android:background="@drawable/bg_btn_primary" android:padding="12dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 方式二：文件导入 -->
            <LinearLayout android:id="@+id/btnImportFile" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="16dp" android:background="@drawable/bg_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📂" android:textSize="24sp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="从文件导入" android:textSize="16sp" android:textStyle="bold"
                        android:textColor="@color/text_main"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="支持 txt / md / word（.docx）等文本文件"
                        android:textSize="12sp" android:textColor="@color/text_sub"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="24sp" android:textColor="@color/text_sub"/>
            </LinearLayout>

            <!-- 格式说明 -->
            <TextView android:id="@+id/tvFormatHint" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="导入格式说明：每道题以空行分隔；第一行题干，之后每行一个选项（A. xxx），正确答案行以「答案：A」标注，解析行以「解析：...」标注。也支持 JSON 数组格式。"
                android:textSize="12sp" android:textColor="@color/text_sub" android:lineSpacingExtra="2dp"/>

            <!-- 清空按钮 -->
            <TextView android:id="@+id/btnClearBank" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:gravity="center" android:text="清空自定义题库" android:textSize="14sp"
                android:textColor="@color/danger" android:background="@drawable/bg_option_normal"
                android:padding="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
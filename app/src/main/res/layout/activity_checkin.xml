<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_page">
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@drawable/bg_result_header_chalk" android:orientation="horizontal"
android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="←" android:textColor="@color/text_on_primary" android:textSize="22sp" android:padding="8dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="每日打卡" android:textColor="@color/text_on_primary" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/text_on_primary"/>
    </LinearLayout>
    <TextView android:id="@+id/tvStreak" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="已连续打卡 0 天" android:textSize="16sp"
        android:textColor="@color/text_main" android:padding="20dp"/>
    <Button android:id="@+id/btnCheckin" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:text="今日打卡" android:textColor="@color/text_on_primary"
        android:background="@drawable/bg_btn_primary" android:textSize="16sp"/>
    <TextView android:id="@+id/tvHint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="" android:textSize="14sp" android:textColor="@color/text_sub" android:padding="16dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page">
    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none"
        android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 顶部头部卡片：考试类型 + 类目标签 ===== -->
        <LinearLayout android:id="@+id/headerContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp" android:background="@drawable/bg_header_chalk"
            android:padding="16dp">

            <!-- 第一行：考试类型标题（点击切换） -->
            <LinearLayout android:id="@+id/rowExamType" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏆" android:textSize="@dimen/text_title_large" />
                <TextView android:id="@+id/tvExamTypeName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="中国电子学会等级考试" android:maxLines="1"
                    android:textSize="@dimen/text_title_medium" android:textStyle="bold" android:textColor="@android:color/white" />
                <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_arrow_down_white" android:contentDescription="选择考试类型" />
                <ImageView android:id="@+id/btnExamTypeSettings" android:layout_width="36dp"
                    android:layout_height="36dp" android:layout_marginStart="8dp"
                    android:src="@drawable/ic_settings" android:contentDescription="自定义排序"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <!-- 第二行：类目标签（横向滚动） -->
            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:id="@+id/llCategories" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ===== 中部黄框：功能卡片区 ===== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="12dp"
            android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_chalk">


            <!-- 宫格导航：5 列图标网格 -->
            <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:columnCount="5"
                android:alignmentMode="alignMargins">

                <!-- 1 真题练习 -->
                <LinearLayout android:id="@+id/cardPractice" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp"
                            android:src="@drawable/ic_grid_exam"
                            android:padding="12dp" android:background="@drawable/bg_grid_icon"
                            android:contentDescription="真题练习" />
                    </FrameLayout>
                    <TextView android:id="@+id/labelPractice" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="真题练习" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 2 题库练习 -->
                <LinearLayout android:id="@+id/modeSequence" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_sequence"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="题库练习" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="题库练习" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 3 随机练习 -->
                <LinearLayout android:id="@+id/modeRandom" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_random"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="随机练习" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="随机练习" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 4 错题本 -->
                <FrameLayout android:id="@+id/cardWrongBook" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_gravity="top">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp"
                            android:src="@drawable/ic_grid_wrongbook"
                            android:padding="12dp" android:background="@drawable/bg_grid_icon"
                            android:contentDescription="错题本" />
                        <TextView android:id="@+id/labelWrongBook" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="错题本" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                    </LinearLayout>
                    <!-- 数量角标：外层裁剪容器 + 内层数字，数字变化时上下滑动顶替 -->
                    <FrameLayout android:id="@+id/badgeWrongBox" android:layout_width="wrap_content"
                        android:layout_height="18dp" android:minWidth="18dp"
                        android:background="@drawable/bg_badge_danger"
                        android:clipChildren="true" android:clipToPadding="true"
                        android:visibility="gone" android:layout_gravity="top|end" android:layout_marginTop="1dp">
                        <TextView android:id="@+id/badgeWrong" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:layout_gravity="center"
                            android:gravity="center" android:includeFontPadding="false"
                            android:text="0" android:textSize="@dimen/text_micro" android:textColor="@android:color/white"
                            android:paddingStart="6dp" android:paddingEnd="6dp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 5 收藏题 -->
                <FrameLayout android:id="@+id/cardFavorite" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:layout_gravity="top">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:paddingTop="6dp" android:paddingBottom="6dp">
                        <ImageView android:layout_width="52dp" android:layout_height="52dp"
                            android:src="@drawable/ic_grid_favorite"
                            android:padding="12dp" android:background="@drawable/bg_grid_icon"
                            android:contentDescription="收藏题" />
                        <TextView android:id="@+id/labelFavorite" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="收藏题" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                    </LinearLayout>
                    <!-- 数量角标：外层裁剪容器 + 内层数字，数字变化时上下滑动顶替 -->
                    <FrameLayout android:id="@+id/badgeFavoriteBox" android:layout_width="wrap_content"
                        android:layout_height="18dp" android:minWidth="18dp"
                        android:background="@drawable/bg_badge_warning"
                        android:clipChildren="true" android:clipToPadding="true"
                        android:visibility="gone" android:layout_gravity="top|end" android:layout_marginTop="1dp">
                        <TextView android:id="@+id/badgeFavorite" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:layout_gravity="center"
                            android:gravity="center" android:includeFontPadding="false"
                            android:text="0" android:textSize="@dimen/text_micro" android:textColor="@android:color/white"
                            android:paddingStart="6dp" android:paddingEnd="6dp" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 6 学习统计 -->
                <LinearLayout android:id="@+id/cardStatistics" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_stats"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="学习统计" />
                    <TextView android:id="@+id/labelStatistics" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="学习统计" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 7 打卡日历 -->
                <LinearLayout android:id="@+id/cardCalendar" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_calendar"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="打卡日历" />
                    <TextView android:id="@+id/labelCalendar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="打卡日历" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 8 自定义题库 -->
                <LinearLayout android:id="@+id/cardCustomBank" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_puzzle"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="上传题目" />
                    <TextView android:id="@+id/labelCustomBank" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="上传题目" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 9 知识点专题 -->
                <LinearLayout android:id="@+id/cardKnowledge" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp">
                    <ImageView android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_grid_knowledge"
                        android:padding="12dp" android:background="@drawable/bg_grid_icon"
                        android:contentDescription="知识点专题" />
                    <TextView android:id="@+id/labelKnowledge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="知识点专题" android:textSize="@dimen/text_label_medium" android:textColor="@color/text_main" />
                </LinearLayout>

                <!-- 10 占位空格 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:orientation="vertical" android:gravity="center"
                    android:paddingTop="6dp" android:paddingBottom="6dp" />
            </GridLayout>

            <!-- 继续上次（有进度时显示） -->
            <LinearLayout android:id="@+id/btnResume" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:padding="12dp" android:background="@drawable/bg_resume" android:visibility="gone">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="继续上次练习" android:textSize="@dimen/text_body_medium" android:textStyle="bold" android:textColor="@color/primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="▶" android:textSize="@dimen/text_body_large" android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 底部绿框：三级容器骨架 ===== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="12dp"
            android:layout_marginBottom="80dp" android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_card_chalk">
            <LinearLayout android:id="@+id/llGreenContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <ImageView android:id="@+id/fabSettings" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="bottom|end" android:layout_marginEnd="20dp" android:layout_marginBottom="20dp"
        android:padding="16dp" android:background="@drawable/bg_btn_primary" android:src="@drawable/ic_settings"
        android:contentDescription="设置" />
</FrameLayout>

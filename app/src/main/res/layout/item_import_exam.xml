<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/card_bg">
    <CheckBox
        android:id="@+id/cbImportSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false"
        android:layout_gravity="center_vertical" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvImportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/text_title_small"
            android:textColor="@color/text_main"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tvImportSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="@dimen/text_label_medium"
            android:textColor="@color/text_sub"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tvImportRepo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textSize="@dimen/text_label_small"
            android:textColor="@color/text_sub"
            android:maxLines="1"
            android:ellipsize="middle" />
    </LinearLayout>
    <!-- 右下角：下载进度 / 解析中 / 解析完成 -->
    <TextView
        android:id="@+id/tvImportStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:minWidth="56dp"
        android:gravity="end"
        android:text=""
        android:textSize="@dimen/text_body_small"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:visibility="gone" />
</LinearLayout>

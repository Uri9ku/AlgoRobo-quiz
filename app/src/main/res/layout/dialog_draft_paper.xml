<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draftRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/on_primary_80"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="草稿纸" android:textSize="@dimen/text_body_large" android:textStyle="bold"
        android:textColor="@color/text_main" android:gravity="center"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/btnDraftClear" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="清空" android:textSize="@dimen/text_body_medium"
            android:textColor="@color/primary" android:padding="8dp"/>
        <TextView android:id="@+id/btnDraftSave" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="保存" android:textSize="@dimen/text_body_medium"
            android:textColor="@color/primary" android:padding="8dp" android:layout_marginLeft="16dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/btnDraftClose" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="关闭" android:textSize="@dimen/text_body_medium"
            android:textColor="@color/text_sub" android:padding="8dp"/>
    </LinearLayout>

    <!-- 透明度调节：控制草稿纸底色的透明程度，便于边看题边打草稿 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="透明度" android:textSize="@dimen/text_body_small" android:textColor="@color/text_sub"/>
        <SeekBar android:id="@+id/sbDraftAlpha" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:max="100" android:progress="80"/>
        <TextView android:id="@+id/tvDraftAlphaValue" android:layout_width="44dp" android:layout_height="wrap_content"
            android:gravity="end" android:text="80%" android:textSize="@dimen/text_body_small" android:textColor="@color/text_sub"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="4dp" android:background="@color/divider"/>

    <com.algorobo.quiz.DrawPadView
        android:id="@+id/drawPad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/transparent"/>
</LinearLayout>

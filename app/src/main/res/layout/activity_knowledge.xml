<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_result_header_chalk">

        <ImageView
            android:id="@+id/btnKnowledgeBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            android:contentDescription="返回"
            android:padding="4dp" />

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="知识点专题"
            android:textSize="@dimen/text_title_large"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary" />

        <TextView
            android:id="@+id/btnKnowledgeAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋ 新增"
            android:textSize="@dimen/text_body_large"
            android:textColor="@color/text_on_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/knowledgeEmptyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvKnowledgeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:gravity="center"
            android:text="暂无知识点\n可点击右上角「＋ 新增」创建，或「去真题导入」获取带知识点的题目"
            android:textSize="@dimen/text_body_medium"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_sub" />

        <TextView
            android:id="@+id/btnGoImportExam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="12dp"
            android:paddingHorizontal="24dp"
            android:text="去真题导入"
            android:textSize="@dimen/text_body_medium"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvKnowledge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp" />
</LinearLayout>

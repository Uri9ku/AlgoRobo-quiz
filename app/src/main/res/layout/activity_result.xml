<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_page">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_result_header" android:padding="28dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="本次练习完成" android:textSize="16sp" android:textColor="@color/text_on_primary_70" android:layout_gravity="center_horizontal"/>
<TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="90" android:textSize="48sp" android:textStyle="bold" android:textColor="@android:color/white" android:layout_gravity="center_horizontal"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="分" android:textSize="14sp" android:textColor="@color/text_on_primary_70" android:layout_gravity="center_horizontal"/>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal" android:layout_gravity="center_horizontal">
<TextView android:id="@+id/tvCorrect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="答对 13" android:textSize="14sp" android:textColor="@color/text_on_primary" android:padding="6dp" android:background="@drawable/bg_result_correct"/>
<TextView android:id="@+id/tvWrong" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="答错 2" android:textSize="14sp" android:textColor="@color/text_on_primary" android:padding="6dp" android:background="@drawable/bg_result_wrong"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="20dp" android:background="@color/card_bg">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<TextView android:id="@+id/tvAccuracy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="87%" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正确率" android:textSize="12sp" android:textColor="@color/text_sub"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:32" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用时" android:textSize="12sp" android:textColor="@color/text_sub"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
<TextView android:id="@+id/btnResultHome" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="返回首页" android:textSize="15sp" android:textColor="@color/primary" android:background="@drawable/bg_btn_outline_press"/>
<TextView android:id="@+id/btnResultAgain" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="全部解析" android:textSize="15sp" android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary_press"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
<TextView android:id="@+id/btnResultRedoWrong" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="错题重刷" android:textSize="15sp" android:textColor="@color/primary" android:background="@drawable/bg_btn_outline_press"/>
<TextView android:id="@+id/btnResultOneMore" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="再练一组" android:textSize="15sp" android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary_press"/>
</LinearLayout>
</LinearLayout>
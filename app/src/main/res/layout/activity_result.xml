<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_page">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_result_header_chalk" android:padding="28dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="本次练习完成" android:textSize="16sp" android:textColor="@color/text_on_primary_70" android:layout_gravity="center_horizontal"/>
<!-- 分数：裁剪容器 + 数字，切换隐藏实操题时播放滑动动画 -->
<FrameLayout android:id="@+id/scoreBox" android:layout_width="wrap_content" android:layout_height="66dp" android:layout_gravity="center_horizontal" android:clipChildren="true" android:clipToPadding="true">
<TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:includeFontPadding="false" android:text="" android:textSize="48sp" android:textStyle="bold" android:textColor="@android:color/white"/>
</FrameLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="分" android:textSize="14sp" android:textColor="@color/text_on_primary_70" android:layout_gravity="center_horizontal"/>
<!-- 答对/答错居中；隐藏实操题靠最右，不参与居中 -->
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical">
<!-- 答对：标签固定，只有数字做滑动切换 -->
<LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/bg_result_correct">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="答对" android:textSize="14sp" android:textColor="@color/text_on_primary" android:includeFontPadding="false"/>
<FrameLayout android:id="@+id/correctBox" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="5dp" android:clipChildren="true" android:clipToPadding="true">
<TextView android:id="@+id/tvCorrect" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:includeFontPadding="false" android:text="" android:textSize="14sp" android:textColor="@color/text_on_primary"/>
</FrameLayout>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/bg_result_wrong">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="答错" android:textSize="14sp" android:textColor="@color/text_on_primary" android:includeFontPadding="false"/>
<FrameLayout android:id="@+id/wrongBox" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="5dp" android:clipChildren="true" android:clipToPadding="true">
<TextView android:id="@+id/tvWrong" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:includeFontPadding="false" android:text="" android:textSize="14sp" android:textColor="@color/text_on_primary"/>
</FrameLayout>
</LinearLayout>
                </LinearLayout>
</FrameLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="20dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="-20dp" android:background="@drawable/bg_card_chalk">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<!-- 正确率：只有数字做滑动切换，百分号固定 -->
<FrameLayout android:id="@+id/accuracyBox" android:layout_width="wrap_content" android:layout_height="30dp" android:clipChildren="true" android:clipToPadding="true">
<TextView android:id="@+id/tvAccuracy" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:includeFontPadding="false" android:text="" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary"/>
</FrameLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="%" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary" android:includeFontPadding="false"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正确率" android:textSize="12sp" android:textColor="@color/text_sub"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
<TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:32" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/primary"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用时" android:textSize="12sp" android:textColor="@color/text_sub"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:paddingBottom="20dp">
<TextView android:id="@+id/btnResultHome" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:gravity="center" android:text="返回首页" android:textSize="15sp" android:textColor="@color/primary" android:background="@drawable/bg_btn_outline_press"/>
<!-- 隐藏/显示实操题：按钮式，文本区分状态 -->
<TextView android:id="@+id/btnResultHidePractical" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1.3" android:layout_marginEnd="8dp" android:gravity="center" android:text="隐藏实操题" android:textSize="14sp" android:textColor="@color/primary" android:background="@drawable/bg_btn_outline_press"/>
<TextView android:id="@+id/btnResultAgain" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="全部解析" android:textSize="15sp" android:textColor="@android:color/white" android:background="@drawable/bg_btn_primary_press"/>
</LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/primary">
            <TextView
                android:id="@+id/btnImportBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8249; 返回"
                android:textSize="18sp"
                android:textColor="@android:color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="在线导入真题"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <EditText
                    android:id="@+id/etImportSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="搜索试卷名字"
                    android:textSize="14sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_search"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/btnImportFilterYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="年份"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:background="@drawable/bg_filter"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
                <TextView
                    android:id="@+id/btnImportFilterMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="月份"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:background="@drawable/bg_filter"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
                <TextView
                    android:id="@+id/btnImportFilterSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="科目"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:background="@drawable/bg_filter"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
                <TextView
                    android:id="@+id/btnImportFilterLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="等级"
                    android:textSize="13sp"
                    android:textColor="@color/text_main"
                    android:background="@drawable/bg_filter"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="4dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
                <TextView
                    android:id="@+id/tvImportFilterReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="重置"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/tvImportSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="数据来源于 GitHub 仓库 Uri9ku/CIE-ETQ"
            android:textSize="11sp"
            android:textColor="@color/text_sub"
            android:background="@color/bg_page" />
        <ListView
            android:id="@+id/listImportExam"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/card_bg">
            <TextView
                android:id="@+id/tvImportCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_sub" />
            <TextView
                android:id="@+id/btnImportCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textSize="14sp"
                android:textColor="@color/text_main"
                android:background="@drawable/bg_btn_outline"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <TextView
                android:id="@+id/btnImportSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="全选"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_btn_outline"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <TextView
                android:id="@+id/btnImportConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="导入所选"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_btn_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card"
    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp">

    <TextView android:id="@+id/tvAnalysisIndex" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="第 1 题" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold" />

    <TextView android:id="@+id/tvAnalysisType" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="单选题" android:textSize="11sp" android:textColor="@color/text_sub"
        android:background="@drawable/bg_tag_gray" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="2dp" android:paddingBottom="2dp" />

    <TextView android:id="@+id/tvAnalysisStem" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="" android:textSize="16sp" android:lineSpacingExtra="3dp" android:textColor="@color/text_main" />
    <ImageView android:id="@+id/ivAnalysisStemImage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:adjustViewBounds="true" android:maxHeight="240dp"
        android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="题干图片" />
    <TextView android:id="@+id/tvAnalysisOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="" android:textSize="14sp" android:lineSpacingExtra="3dp" android:textColor="@color/text_main" />
    <LinearLayout android:id="@+id/analysisOptionImages" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/tvAnalysisUser" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="你的答案：A" android:textSize="13sp" android:textColor="@color/text_main"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/bg_tag_gray" />
        <TextView android:id="@+id/tvAnalysisCorrectAns" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="正确答案：C" android:textSize="13sp" android:textColor="@color/answer_correct_text"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:background="@drawable/bg_tag_blue" />
        <TextView android:id="@+id/tvAnalysisResult" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="✓正确" android:textSize="13sp" android:textColor="@color/answer_correct_text"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/divider" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="解析" android:textSize="12sp" android:textColor="@color/text_sub" />
    <TextView android:id="@+id/tvAnalysisDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="" android:textSize="14sp" android:lineSpacingExtra="3dp" android:textColor="@color/text_main" />
</LinearLayout>
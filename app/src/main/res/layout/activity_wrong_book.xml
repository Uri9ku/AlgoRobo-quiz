<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_page">
<LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/primary" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/btnWrongBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ 返回" android:textSize="16sp" android:textColor="@android:color/white" android:padding="4dp"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="错题本" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/white"/>
<TextView android:id="@+id/btnWrongClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清空" android:textSize="14sp" android:textColor="@android:color/white" android:padding="4dp"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/tvWrongEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="14sp" android:textColor="@color/text_sub" android:padding="40dp" android:text="暂无错题，继续加油！" android:visibility="gone"/>
<ListView android:id="@+id/listWrong" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@color/divider" android:dividerHeight="1dp"/>
</LinearLayout>
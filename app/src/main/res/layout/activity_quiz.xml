<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg_page">

    <!-- 顶部工具栏 -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_result_header_chalk">
        <LinearLayout android:id="@+id/topBarInner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
            <TextView android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ 返回" android:textSize="16sp" android:textColor="@android:color/white" android:padding="4dp"/>
            <TextView android:id="@+id/tvPaperTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:text="" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:singleLine="true" android:ellipsize="end" android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="@android:color/white" android:fontFamily="sans-serif-medium"/>        </LinearLayout>

        <!-- 工具栏图标：收藏 / 加入错题本 / 草稿纸 / 答题卡 / 更多 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
            <ImageView android:id="@+id/btnToolTime" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_tool_time" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/btnToolWrongbook" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_tool_wrongbook" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/btnToolDownload" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_tool_draft" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/btnToolSheet" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_tool_sheet" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/btnToolMore" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_tool_more" android:padding="8dp" android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/pbProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progress="0"/>
    </LinearLayout>

    <ScrollView android:id="@+id/scrollQuestion" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/questionContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <!-- 跳题索引条 -->
            <HorizontalScrollView android:id="@+id/indexScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout android:id="@+id/indexContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"/>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                <!-- 题型/分值/知识点/错题来源 标签区：子标签过多时横向滑动，统计固定在右侧 -->
                <HorizontalScrollView android:id="@+id/typeScroll" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:scrollbars="none" android:overScrollMode="never">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/tvQuestionType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="单选题" android:textSize="13sp" android:textColor="@color/primary" android:background="@drawable/bg_tag_blue" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                        <TextView android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="5分" android:textSize="13sp" android:textColor="@color/text_sub" android:background="@drawable/bg_tag_gray" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
                        <TextView android:id="@+id/tvKnowledgeTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxWidth="150dp" android:maxLines="1" android:ellipsize="end" android:text="知识点" android:textSize="13sp" android:textColor="@color/text_sub" android:background="@drawable/bg_tag_gray" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                        <TextView android:id="@+id/tvSource" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxWidth="150dp" android:maxLines="1" android:ellipsize="end" android:text="错题来源" android:textSize="13sp" android:textColor="@color/text_sub" android:background="@drawable/bg_tag_gray" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone"/>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView android:id="@+id/btnStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="统计" android:textSize="13sp" android:textColor="@color/text_sub" android:background="@drawable/bg_tag_gray" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
            </LinearLayout>
            <TextView android:id="@+id/tvQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="" android:textSize="17sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_main"/>
            <!-- 题干混排容器：按 docx 顺序渲染「文字 / 图片」块（文字+多图） -->
            <LinearLayout android:id="@+id/stemContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"/>
            <ImageView android:id="@+id/ivStemImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:adjustViewBounds="true" android:maxHeight="240dp" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="题干图片"/>
            <LinearLayout android:id="@+id/optionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>

            <LinearLayout android:id="@+id/analysisPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card_chalk" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tvResultText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="回答错误" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/answer_wrong_text"/>
                    <TextView android:id="@+id/btnAiAnalysis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI解析" android:textSize="16sp" android:textColor="@color/primary" android:background="@drawable/bg_tag_blue" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
                </LinearLayout>
                <TextView android:id="@+id/tvAnswerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="正确答案：B" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/answer_correct_text" android:fontFamily="sans-serif-medium"/>
                <!-- 解析：默认折叠为按钮，点击才展开文本 -->
                <TextView android:id="@+id/btnShowAnalysis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="解析" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/primary" android:background="@drawable/bg_tag_blue" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone"/>
                <TextView android:id="@+id/tvAnalysisText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_main" android:visibility="gone"/>
                <TextView android:id="@+id/tvAiAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textColor="@color/text_main" android:visibility="gone"/>
                <!-- 保留容器但不再填充：答题框内不重复显示题目图片 -->
                <LinearLayout android:id="@+id/analysisImagesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>